{
  "name": "migasto-firestore-rules-tests",
  "private": true,
  "type": "module",
  "description": "Pruebas de las reglas de seguridad de Firestore con el emulador de Firebase",
  "scripts": {
    "test": "firebase emulators:exec --project demo-migasto --only firestore --config ../firebase.json \"node --test rules.test.mjs\"",
    "test:android": "firebase emulators:exec --project demo-migasto --only auth,firestore --config ../firebase.json \"cd .. && ./gradlew :app:testDebugUnitTest --tests '*FirebaseEmulatorTest*'\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.32.1"
  }
}
