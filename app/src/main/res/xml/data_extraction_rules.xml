<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad de Android (12+): en modo local se guardan la base de datos,
     las fotos y las preferencias para poder restaurarlas en un móvil nuevo. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="migasto.db" />
        <include domain="file" path="photos/" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="migasto.db" />
        <include domain="file" path="photos/" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
